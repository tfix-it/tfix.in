# Copy to tprint.env on Shop PC 1 (same folder as this file) and fill in.
# tprint.env is private: it holds the shop token. Never share or commit it.
# Read by windows\watchdog.ps1 when it starts T Print automatically.

PRINTSHOP_CLOUD_URL=https://print.tfix.in/api/shop.php
PRINTSHOP_CLOUD_TOKEN=PASTE_THE_SHOP_TOKEN_HERE

# Optional — only if you changed them:
# PRINTSHOP_PORT=443
# SUMATRA_PATH=C:\Tools\SumatraPDF\SumatraPDF.exe
# LIBREOFFICE_PATH=C:\Program Files\LibreOffice\program\soffice.exe
